<Window x:Class="StudyAssistant.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14"
        Foreground="{StaticResource Text}"
        KeyDown="Window_KeyDown" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid Margin="26">
        <Border CornerRadius="22" Background="{StaticResource BgGrad}" BorderBrush="#33FFFFFF" BorderThickness="1"
                Width="400" Padding="28,26,28,22">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.7" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid Width="42" Height="42">
                        <Ellipse x:Name="IconBg" Fill="#33E58A8A"/>
                        <TextBlock x:Name="IconText" Text="!" FontSize="22" FontWeight="Bold" Foreground="#E58A8A"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>

                <TextBlock x:Name="MessageText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                           LineHeight="22" Margin="0,18,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
                    <Button x:Name="CancelBtn" Content="Vazgeç" Style="{StaticResource Btn}" Padding="20,10"
                            IsCancel="True" Click="Cancel_Click"/>
                    <Button x:Name="OkBtn" Style="{StaticResource Btn}" Padding="20,10" Margin="10,0,0,0"
                            Foreground="#0A0E1A" FontWeight="SemiBold" Click="Ok_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
