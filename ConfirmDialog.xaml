<Window x:Class="FlowState.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="SemiBold"
        Foreground="{StaticResource Text}"
        KeyDown="Window_KeyDown" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <!-- Gölgenin sığması için kenar boşluğu -->
    <Grid Margin="34,26,34,42">
        <Border x:Name="CardBox" Style="{StaticResource Card}" Effect="{StaticResource LiftShadow}"
                Width="400" Padding="28,26,28,22" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PopScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <!-- Yuvarlak yumuşak ikon rozeti: tehlikede pembe/kırmızı, diğerlerinde tema rengi -->
                    <Grid Width="52" Height="52">
                        <Ellipse x:Name="IconBg" Fill="{StaticResource DangerSoft}"/>
                        <Path x:Name="IconPath" Data="M12,6 L12,13.5 M12,17.9 L12,18" Width="24" Height="24" Stretch="None"
                              Stroke="{StaticResource Danger}" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                    <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Black" VerticalAlignment="Center" Margin="14,0,0,0"
                               TextWrapping="Wrap" MaxWidth="280"/>
                </StackPanel>

                <TextBlock x:Name="MessageText" Style="{StaticResource Body}" LineHeight="22" Margin="2,18,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button x:Name="CancelBtn" Content="Vazgeç" Style="{StaticResource Btn}" Padding="20,10"
                            IsCancel="True" Click="Cancel_Click"/>
                    <Button x:Name="OkBtn" Style="{StaticResource Primary}" Padding="22,10" Margin="10,0,0,0" Click="Ok_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
