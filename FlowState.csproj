<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>FlowState</AssemblyName>
    <Product>Flow State</Product>
    <RootNamespace>FlowState</RootNamespace>
  </PropertyGroup>

  <!-- Android (MAUI) projesi Mobile klasöründe; Windows derlemesine karışmasın -->
  <ItemGroup>
    <Compile Remove="Mobile/**;tools/**" />
    <Page Remove="Mobile/**;tools/**" />
    <EmbeddedResource Remove="Mobile/**;tools/**" />
    <None Remove="Mobile/**;tools/**" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <!-- Sprite şeritleri: hayvanlar (tools/build-sprites.ps1) ve odak çemberindeki gezgin (tools/build-explorer.ps1) -->
  <ItemGroup>
    <Resource Include="Assets\pixellab\*.png" />
    <Resource Include="Assets/explorer/*.png" />
  </ItemGroup>

</Project>

