<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>FlowState</AssemblyName>
    <Product>Flow State</Product>
    <Company>Puelvo</Company>
    <Authors>Puelvo</Authors>
    <AssemblyTitle>Flow State</AssemblyTitle>
    <Description>Flow State: ders çalışma süresi takibi</Description>
    <Copyright>© 2026 Puelvo</Copyright>
    <RepositoryUrl>https://github.com/Puelvo/flow-state</RepositoryUrl>
    <NeutralLanguage>tr-TR</NeutralLanguage>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Deterministic>true</Deterministic>
    <RootNamespace>FlowState</RootNamespace>
  </PropertyGroup>

  <!-- Android (MAUI) projesi Mobile klasöründe; Windows derlemesine karışmasın -->
  <ItemGroup>
    <Compile Remove="Mobile/**;tools/**" />
    <Page Remove="Mobile/**;tools/**" />
    <EmbeddedResource Remove="Mobile/**;tools/**" />
    <None Remove="Mobile/**;tools/**" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <!-- Yazı tipi (Nunito, OFL) ve sprite şeritleri: hayvanlar (tools/build-sprites.ps1) ve odak çemberindeki gezgin (tools/build-explorer.ps1) -->
  <ItemGroup>
    <Resource Include="Assets\pixellab\*.png" />
    <Resource Include="Assets/explorer/*.png" />
    <Resource Include="Assets/fonts/*.ttf" />
    <Resource Include="Assets/logo.png" />
  </ItemGroup>

</Project>

