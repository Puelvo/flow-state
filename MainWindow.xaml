<Window x:Class="FlowState.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flow State" Height="840" Width="1080" MinHeight="660" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgGrad}"
        Foreground="{StaticResource Text}" FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="SemiBold"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing"
        PreviewMouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="T1" Storyboard.TargetProperty="X" From="-60" To="220" Duration="0:0:17">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="T1" Storyboard.TargetProperty="Y" From="-40" To="160" Duration="0:0:23">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="T2" Storyboard.TargetProperty="X" From="60" To="-260" Duration="0:0:21">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="T2" Storyboard.TargetProperty="Y" From="40" To="-180" Duration="0:0:27">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="T3" Storyboard.TargetProperty="X" From="40" To="-280" Duration="0:0:25">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="T3" Storyboard.TargetProperty="Y" From="-30" To="170" Duration="0:0:19">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="T4" Storyboard.TargetProperty="X" From="-30" To="300" Duration="0:0:29">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="T4" Storyboard.TargetProperty="Y" From="30" To="-200" Duration="0:0:22">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Hareketli arka plan: krem zeminde yavaşça süzülen pastel ışık lekeleri ve uçuşan küçük şekerlemeler -->
        <Grid x:Name="BgLayer" Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="760" Height="760" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-280,-320,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="Blob1A" Color="#55B9CDFF" Offset="0"/>
                        <GradientStop x:Name="Blob1B" Color="#00B9CDFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform x:Name="T1"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="720" Height="720" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-260,-300">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="Blob2A" Color="#66FFC9A8" Offset="0"/>
                        <GradientStop x:Name="Blob2B" Color="#00FFC9A8" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform x:Name="T2"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="620" Height="620" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-220,-220,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="BlobC1" Color="#66FFE39A" Offset="0"/>
                        <GradientStop x:Name="BlobC2" Color="#00FFE39A" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform x:Name="T3"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="600" Height="600" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-200,0,0,-260">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="Blob4A" Color="#55B8F0D6" Offset="0"/>
                        <GradientStop x:Name="Blob4B" Color="#00B8F0D6" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform x:Name="T4"/></Ellipse.RenderTransform>
            </Ellipse>
            <!-- Uçuşan pastel noktalar ve yıldızcıklar (BuildStars) -->
            <Canvas x:Name="StarCanvas"/>
        </Grid>

        <!-- Üst çubuk: logo, ikonlu sekmeler, widget düğmesi -->
        <Grid x:Name="TopBar" Grid.Row="0" Margin="24,18,24,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Logo: tema renginde sevimli bir damla + yazı -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="34" Height="34">
                    <Ellipse Fill="{DynamicResource Accent}"/>
                    <Ellipse Width="11" Height="7" Fill="#FFFFFF" Opacity="0.45" Margin="0,0,9,14"/>
                    <Path Data="M7,9.5 L7,10.5 M17,9.5 L17,10.5 M9.5,14 C10.8,15.6 13.2,15.6 14.5,14" Width="16" Height="12"
                          Stretch="Uniform" Stroke="{DynamicResource OnAccent}" StrokeThickness="2.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,4,0,0"/>
                </Grid>
                <TextBlock Text="Flow State" FontSize="19" FontWeight="Black" Margin="10,0,0,0"
                           Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource SegBar}" CornerRadius="24" Padding="5">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="NavTimer" GroupName="nav" Style="{StaticResource Nav}" IsChecked="True" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTimer}" Style="{StaticResource Icon}"/>
                            <TextBlock Text="Çalış" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavStats" GroupName="nav" Style="{StaticResource Nav}" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconChart}" Style="{StaticResource Icon}"/>
                            <TextBlock Text="İstatistik" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavHistory" GroupName="nav" Style="{StaticResource Nav}" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconHistory}" Style="{StaticResource Icon}"/>
                            <TextBlock Text="Geçmiş" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavZoo" GroupName="nav" Style="{StaticResource Nav}" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPaw}" Style="{StaticResource Icon}" StrokeThickness="2"/>
                            <TextBlock Text="Bahçe" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSocial" GroupName="nav" Style="{StaticResource Nav}" Checked="Nav_Checked">
                        <StackPanel x:Name="NavSocialPanel" Orientation="Horizontal">
                            <Path Data="{StaticResource IconPeople}" Style="{StaticResource Icon}"/>
                            <TextBlock Text="Sosyal" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" GroupName="nav" Style="{StaticResource Nav}" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSliders}" Style="{StaticResource Icon}"/>
                            <TextBlock Text="Ayarlar" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <Button Grid.Column="2" Style="{StaticResource Btn}" Background="{StaticResource Surface}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Padding="12,7" FontSize="13"
                    ToolTip="Küçük widget moduna geç" Click="WidgetToggle_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconWidget}" Style="{StaticResource Icon}" Width="15" Height="15" StrokeThickness="2.2"/>
                    <TextBlock Text="Widget" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Çalışma görünümü: ders chip'leri, beyaz bir disk üstünde ilerleme çemberi, büyük süre, saat yıldızları, şeker düğmeler -->
        <ScrollViewer x:Name="TimerView" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="TimerPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,4,24,20" MaxWidth="760">

                <TextBlock x:Name="TimerHello" Text="Bugün neye odaklanıyoruz?" Style="{StaticResource PageSub}"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8"/>

                <ListBox x:Name="CourseList" HorizontalAlignment="Center" SelectionChanged="CourseList_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <StackPanel x:Name="CourseTools" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <Button Style="{StaticResource Ghost}" FontSize="12" Padding="10,5" Click="ToggleAdd_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Style="{StaticResource Icon}" Width="12" Height="12" StrokeThickness="2.6"/>
                            <TextBlock Text="Ders ekle" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeleteCourseBtn" Style="{StaticResource Ghost}" FontSize="12" Padding="10,5" Margin="4,0,0,0"
                            Foreground="{StaticResource Danger}" Click="DeleteCourse_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTrash}" Style="{StaticResource Icon}" Width="12" Height="12" StrokeThickness="2.4"/>
                            <TextBlock Text="Dersi sil" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Yeni ders: küçük beyaz kart -->
                <!-- Mod: kronometre / geri sayım; geri sayımda −/+ ile süre. Oturum sürerken gizlenir ama yer tutar (sayfa zıplamasın). -->
                <StackPanel x:Name="ModePanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Border Style="{StaticResource SegBar}" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ModeStopwatch" GroupName="timermode" Style="{StaticResource Seg}" IsChecked="True" Checked="Mode_Checked"
                                         ToolTip="Süre ileri doğru sayar; istediğin zaman bitir">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconTimer}" Style="{StaticResource Icon}" Width="14" Height="14" StrokeThickness="2.4"/>
                                    <TextBlock Text="Kronometre" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ModeCountdown" GroupName="timermode" Style="{StaticResource Seg}" Checked="Mode_Checked"
                                         ToolTip="Bir süre seç; süre dolunca oturum kendiliğinden biter">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconHourglass}" Style="{StaticResource Icon}" Width="14" Height="14" StrokeThickness="2.4"/>
                                    <TextBlock Text="Geri sayım" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                    <Border x:Name="DurationPanel" Style="{StaticResource SegBar}" Padding="4" Margin="10,0,0,0" Visibility="Collapsed"
                            ToolTip="Süreyi değiştir (fare tekerleği de olur)" MouseWheel="Duration_Wheel" Background="{StaticResource Surface}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Ghost}" Padding="8" Tag="-5" Click="Duration_Click">
                                <Path Data="{StaticResource IconMinus}" Style="{StaticResource Icon}" Width="12" Height="12" StrokeThickness="2.8"/>
                            </Button>
                            <TextBlock x:Name="DurationText" Text="25 dk" FontSize="14" FontWeight="Black" MinWidth="58" TextAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{StaticResource Text}"/>
                            <Button Style="{StaticResource Ghost}" Padding="8" Tag="5" Click="Duration_Click">
                                <Path Data="{StaticResource IconPlus}" Style="{StaticResource Icon}" Width="12" Height="12" StrokeThickness="2.8"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border x:Name="AddPanel" Style="{StaticResource Card}" HorizontalAlignment="Center" Margin="0,8,0,0"
                        Padding="10" CornerRadius="20" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="NewCourseBox" Width="220" MaxLength="40" KeyDown="NewCourseBox_KeyDown"
                                 ToolTip="Ders adını yaz, Enter ile ekle"/>
                        <Button Content="Ekle" Style="{StaticResource Primary}" Padding="16,8" Margin="8,0,0,0" Click="AddCourse_Click"/>
                    </StackPanel>
                </Border>

                <!--
                    Çember: beyaz, gölgeli bir disk; üstünde yumuşak iz halkası ve tema renginde kalın ilerleme yayı (RingArc, kodda çizilir).
                    Ortada dersin renginde pastel bir yüz (RingFace) var; oturum sürerken yavaşça "nefes alır".
                -->
                <Grid x:Name="RingHost" Width="320" Height="320" Margin="0,10,0,0" HorizontalAlignment="Center"
                      Background="Transparent" Cursor="Hand" ToolTip="Başlat / duraklat"
                      PreviewMouseLeftButtonDown="Ring_Down" MouseMove="Ring_Move" MouseLeftButtonUp="Ring_Up">
                    <Ellipse Fill="{StaticResource Surface}" Effect="{StaticResource SoftShadow}"/>
                    <Ellipse x:Name="RingFace" Width="236" Height="236" Fill="{StaticResource Panel2}"
                             Stroke="{StaticResource Line}" StrokeThickness="2.5" StrokeDashArray="0.01 2.8"
                             StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="RingFaceScale"/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Grid Width="300" Height="300">
                        <Ellipse Width="300" Height="300" Stroke="{StaticResource Track}" StrokeThickness="20"/>
                        <Canvas x:Name="RingArc" Width="300" Height="300" Visibility="Collapsed"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="200">
                        <TextBlock x:Name="TimerCourseName" Text="Bir ders seç" FontSize="22" FontWeight="Black"
                                   Foreground="{StaticResource Text}"
                                   TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="68"/>
                        <!-- Durum rozeti: hazır / odakta / mola -->
                        <Border x:Name="StatusPill" HorizontalAlignment="Center" Margin="0,6,0,0" Padding="10,3,12,4"
                                CornerRadius="12" Background="{StaticResource Panel2}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="TimerStatusDot" Width="8" Height="8" Fill="{StaticResource Good}"
                                         VerticalAlignment="Center" Margin="0,1,6,0"/>
                                <TextBlock x:Name="TimerStatus" Foreground="{StaticResource Muted}" FontSize="13" FontWeight="ExtraBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- Gezgin: odaklanırken çemberin içinde yürür (MainWindow.Explorer.cs) -->
                        <Image x:Name="RingWalker" Width="92" Height="92" Margin="0,6,0,0" HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
                    </StackPanel>
                </Grid>

                <!-- Çalışma süresi (çemberin altında): büyük ve kalın -->
                <TextBlock x:Name="ElapsedText" Text="00:00:00" FontSize="42" FontWeight="Black" Foreground="{StaticResource Text}"
                           Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" Margin="0,6,0,0"/>

                <!-- Tamamlanan saatler: her saat için altın bir yıldızcık, süren saat için boş yıldız -->
                <StackPanel x:Name="HourPips" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" Height="18"/>
                <TextBlock x:Name="PipsLabel" Foreground="{StaticResource Muted}" FontSize="14" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>

                <StackPanel x:Name="BtnRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Button x:Name="StartBtn" Style="{StaticResource Round}" Width="92" Height="92" VerticalAlignment="Center"
                            Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" Margin="0,0,18,0"
                            ToolTip="Başlat / duraklat (Boşluk)" Click="StartBtn_Click"/>
                    <Button x:Name="FinishBtn" Style="{StaticResource Round}" Width="72" Height="72" VerticalAlignment="Center"
                            Background="{StaticResource DangerSoft}" Foreground="{StaticResource Danger}"
                            ToolTip="Oturumu bitir ve kaydet" Click="FinishBtn_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- İstatistik görünümü -->
        <ScrollViewer x:Name="StatsView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,20,40,36" MaxWidth="880">
                <StackPanel.Resources>
                    <!-- Grafik boş durum yazısı (çubukların üstünde ortalı) -->
                    <Style x:Key="ChartEmptyText" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="TextAlignment" Value="Center"/>
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="Margin" Value="0,0,0,40"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                    <!-- Bölüm başlığının yanındaki sönük açıklama -->
                    <Style x:Key="HNote" TargetType="Run">
                        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                    <!-- Isı haritası gün etiketi -->
                    <Style x:Key="HeatDay" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="Padding" Value="0,8,0,0"/>
                    </Style>
                </StackPanel.Resources>

                <TextBlock Text="İstatistikler" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Emeğinin izini sür: çalıştığın her dakika burada birikiyor." Style="{StaticResource PageSub}"/>

                <TextBlock Text="Özet" Style="{StaticResource H}" Margin="4,24,0,12"/>
                <UniformGrid x:Name="StatsCards" Columns="4" Margin="0,0,-14,0"/>

                <TextBlock Style="{StaticResource H}">
                    <Run Text="Seri"/><Run Text="   her gün biraz, ama her gün" Style="{StaticResource HNote}"/>
                </TextBlock>
                <UniformGrid x:Name="StreakCards" Columns="3" Margin="0,0,-14,0"/>

                <DockPanel Margin="0,30,0,12">
                    <Border DockPanel.Dock="Right" Style="{StaticResource SegBar}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="seg" Style="{StaticResource Seg}" Content="Bugün" Tag="today" IsChecked="True" Checked="Seg_Checked"/>
                            <RadioButton GroupName="seg" Style="{StaticResource Seg}" Content="Bu hafta" Tag="week" Checked="Seg_Checked"/>
                            <RadioButton GroupName="seg" Style="{StaticResource Seg}" Content="Bu ay" Tag="month" Checked="Seg_Checked"/>
                            <RadioButton GroupName="seg" Style="{StaticResource Seg}" Content="Toplam" Tag="all" Checked="Seg_Checked"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Ders bazında dağılım" Style="{StaticResource H}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                </DockPanel>
                <Border Style="{StaticResource Card}" Padding="22,18,22,8">
                    <StackPanel x:Name="BreakdownPanel"/>
                </Border>

                <TextBlock Style="{StaticResource H}">
                    <Run Text="Son 14 gün"/><Run Text="   bugün renkli" Style="{StaticResource HNote}"/>
                </TextBlock>
                <Border Style="{StaticResource Card}" Padding="16,18,16,12">
                    <Grid>
                        <UniformGrid x:Name="ChartGrid" Columns="14" Height="210"/>
                        <TextBlock x:Name="ChartEmpty" Style="{StaticResource ChartEmptyText}"
                                   Text="Son iki haftada kayıt yok. İlk çubuğu bugün sen dik!"/>
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource H}">
                    <Run Text="Isı haritası"/><Run Text="   son 18 hafta" Style="{StaticResource HNote}"/>
                </TextBlock>
                <Border Style="{StaticResource Card}" Padding="22,20,22,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- Satır etiketleri: Pazartesi başlangıç -->
                            <StackPanel Width="34">
                                <TextBlock Text="Pzt" Style="{StaticResource HeatDay}"/>
                                <TextBlock Text="" Style="{StaticResource HeatDay}"/>
                                <TextBlock Text="Çar" Style="{StaticResource HeatDay}"/>
                                <TextBlock Text="" Style="{StaticResource HeatDay}"/>
                                <TextBlock Text="Cum" Style="{StaticResource HeatDay}"/>
                                <TextBlock Text="" Style="{StaticResource HeatDay}"/>
                                <TextBlock Text="Paz" Style="{StaticResource HeatDay}"/>
                            </StackPanel>
                            <UniformGrid x:Name="HeatGrid" Rows="7" Columns="18"/>
                        </StackPanel>
                        <DockPanel Margin="0,14,0,0">
                            <StackPanel x:Name="HeatLegend" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"/>
                            <TextBlock Text="Her kare bir gün. Renk koyulaştıkça o gün daha çok çalışmışsın."
                                       Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource H}">
                    <Run Text="Haftalık toplam"/><Run Text="   son 8 hafta" Style="{StaticResource HNote}"/>
                </TextBlock>
                <Border Style="{StaticResource Card}" Padding="16,18,16,12">
                    <Grid>
                        <UniformGrid x:Name="WeekGrid" Columns="8" Height="210"/>
                        <TextBlock x:Name="WeekEmpty" Style="{StaticResource ChartEmptyText}"
                                   Text="Haftalar henüz boş. Bir oturum başlat, burası dolmaya başlasın."/>
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource H}">
                    <Run Text="Günün saatleri"/><Run Text="   en çok ne zaman çalışıyorsun?" Style="{StaticResource HNote}"/>
                </TextBlock>
                <Border Style="{StaticResource Card}" Padding="16,18,16,12">
                    <Grid>
                        <UniformGrid x:Name="HourGrid" Columns="24" Height="190"/>
                        <TextBlock x:Name="HourEmpty" Style="{StaticResource ChartEmptyText}"
                                   Text="Biraz çalışınca en verimli saatlerin burada görünecek."/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Geçmiş görünümü -->
        <Grid x:Name="HistoryView" Grid.Row="1" Visibility="Collapsed" Margin="24,20,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="16,0,16,8" MaxWidth="880">
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Background="{StaticResource Surface}"
                        VerticalAlignment="Center" ToolTip="Tüm kayıtları CSV dosyası olarak kaydet" Click="Export_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconDownload}" Style="{StaticResource Icon}" Width="16" Height="16"/>
                        <TextBlock Text="CSV olarak dışa aktar" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Geçmiş" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Her oturum küçük bir adım. İşte bugüne kadarki yolculuğun." Style="{StaticResource PageSub}"/>
                </StackPanel>
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="HistoryPanel" MaxWidth="880" Margin="16,4,16,36"/>
            </ScrollViewer>
        </Grid>

        <!-- Bahçe görünümü: hayvanat bahçesi ve market (içerik MainWindow.Zoo.cs içinde kurulur) -->
        <ScrollViewer x:Name="ZooView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ZooRoot" Margin="40,20,40,36" MaxWidth="880"/>
        </ScrollViewer>

        <!-- Sosyal görünümü: arkadaşlar ve odalar (içerik MainWindow.Social.cs içinde kurulur) -->
        <ScrollViewer x:Name="SocialView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <!-- Bu sayfadaki onay kutuları: yuvarlak, kayan bir anahtar -->
                <Style TargetType="CheckBox">
                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="CheckBox">
                                <StackPanel Orientation="Horizontal" Background="Transparent">
                                    <Grid Width="44" Height="26" VerticalAlignment="Center">
                                        <Border x:Name="track" CornerRadius="13" Background="{StaticResource Track}"/>
                                        <Ellipse x:Name="knob" Width="20" Height="20" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="3,0,3,0">
                                            <Ellipse.Effect>
                                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.25" Color="#B07A55"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                    </Grid>
                                    <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                                        <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="track" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ScrollViewer.Resources>
            <StackPanel x:Name="SocialRoot" Margin="40,20,40,36" MaxWidth="880"/>
        </ScrollViewer>

        <!-- Ayarlar görünümü -->
        <ScrollViewer x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <!--
                    Tema rengi şekeri (BuildSettings kurar). Background = renk, Foreground = tik rengi,
                    Tag="sel" seçili olanı işaretler: dış halka + tik görünür. Üzerine gelince hafifçe büyür.
                -->
                <Style x:Key="Swatch" TargetType="Button">
                    <Setter Property="Width" Value="54"/>
                    <Setter Property="Height" Value="54"/>
                    <Setter Property="Margin" Value="5"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid x:Name="root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/>
                                    </Grid.RenderTransform>
                                    <!-- seçili halka -->
                                    <Ellipse x:Name="ring" Stroke="{TemplateBinding Background}" StrokeThickness="3" Opacity="0"/>
                                    <Grid Margin="7">
                                        <!-- alt dudak -->
                                        <Ellipse Fill="{TemplateBinding Background}" Margin="0,3,0,0"/>
                                        <Ellipse Fill="#30502A10" Margin="0,3,0,0"/>
                                        <Grid x:Name="face" Margin="0,0,0,3">
                                            <Ellipse Fill="{TemplateBinding Background}"/>
                                            <Ellipse Width="12" Height="7" Fill="#FFFFFF" Opacity="0.45" HorizontalAlignment="Left"
                                                     VerticalAlignment="Top" Margin="8,6,0,0" IsHitTestVisible="False"/>
                                            <Path x:Name="check" Data="M5,12.5 L10,17 L19,7.5" Width="17" Height="13" Stretch="Uniform"
                                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="3.2" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0" IsHitTestVisible="False"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Tag" Value="sel">
                                        <Setter TargetName="ring" Property="Opacity" Value="1"/>
                                        <Setter TargetName="check" Property="Opacity" Value="1"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.2">
                                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.2">
                                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                                                    <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="face" Property="Margin" Value="0,3,0,0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <!-- Kart başlığındaki yuvarlak ikon rozeti -->
                <Style x:Key="SettingsBadge" TargetType="Grid">
                    <Setter Property="Width" Value="44"/>
                    <Setter Property="Height" Value="44"/>
                    <Setter Property="Margin" Value="0,0,14,0"/>
                    <Setter Property="VerticalAlignment" Value="Top"/>
                </Style>
                <Style x:Key="SettingsLabel" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12.5"/>
                    <Setter Property="FontWeight" Value="ExtraBold"/>
                    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                    <Setter Property="Margin" Value="4,0,0,6"/>
                </Style>
            </ScrollViewer.Resources>
            <StackPanel Margin="40,20,40,36" MaxWidth="880">
                <TextBlock Text="Ayarlar" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Uygulamayı kendine göre süsle, çalışmaların her cihazda seninle olsun." Style="{StaticResource PageSub}"/>

                <!-- Tema rengi -->
                <Border Style="{StaticResource Card}" Margin="0,22,0,0">
                    <StackPanel>
                        <DockPanel>
                            <Grid Style="{StaticResource SettingsBadge}">
                                <Ellipse Fill="{DynamicResource AccentSoft}"/>
                                <Path Data="{StaticResource IconSparkle}" Fill="{DynamicResource Accent}" Width="20" Height="20" Stretch="Uniform"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Tema rengi" Style="{StaticResource H}" Margin="0"/>
                                <TextBlock Text="Halka, düğmeler, seçili öğeler ve arka plan ışığı bu rengi kullanır. Hem büyük pencerede hem widget'ta geçerlidir."
                                           Style="{StaticResource Body}" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <WrapPanel x:Name="SwatchPanel" Margin="-5,14,0,0"/>
                        <Border Height="2" CornerRadius="1" Background="{StaticResource Line}" Margin="0,14,0,16"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Özel renk" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                            <TextBox x:Name="HexBox" Width="120" MaxLength="7" TextAlignment="Center" Margin="12,0,0,0" FontWeight="ExtraBold"
                                     KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus"/>
                            <Border x:Name="HexPreview" Width="40" Height="40" CornerRadius="20" Margin="12,0,0,0"
                                    BorderBrush="{StaticResource Surface}" BorderThickness="3" Effect="{StaticResource SoftShadow}"/>
                            <TextBlock Text="Enter'a basınca uygulanır" Style="{StaticResource Body}" FontSize="12.5" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="HexError" Foreground="{StaticResource Danger}" FontSize="12.5" FontWeight="Bold" Margin="2,10,0,0" Visibility="Collapsed"
                                   Text="Geçerli bir renk gir (örn. #FF5A6A)."/>
                    </StackPanel>
                </Border>

                <!-- Senkronizasyon -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <DockPanel>
                            <Grid Style="{StaticResource SettingsBadge}">
                                <Ellipse Fill="{StaticResource GoodSoft}"/>
                                <Path Data="M7,18.5 L17.5,18.5 C20,18.5 21.5,16.7 21.5,14.5 C21.5,12.3 19.8,10.7 17.7,10.8 C17,8.1 14.7,6.3 12,6.3 C8.9,6.3 6.4,8.7 6.2,11.7 C4.1,12 2.5,13.6 2.5,15.4 C2.5,17.2 4.2,18.5 7,18.5 Z"
                                      Stroke="{StaticResource Good}" StrokeThickness="2.2" StrokeLineJoin="Round" Width="22" Height="22" Stretch="Uniform"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Senkronizasyon" Style="{StaticResource H}" Margin="0"/>
                                <TextBlock Text="Telefon ve bilgisayardaki çalışmaların aynı hesapta birleşir. Veriler önce bu cihazda tutulur, internet yokken de çalışır; bağlantı olunca arka planda eşitlenir."
                                           Style="{StaticResource Body}" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Durum hapı (RefreshSyncUi renklendirir) -->
                        <Border x:Name="SyncPill" Background="{StaticResource Panel2}" CornerRadius="14" Padding="12,6,14,7"
                                HorizontalAlignment="Left" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SyncDot" Width="9" Height="9" Fill="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                <TextBlock x:Name="SyncStatus" Foreground="{StaticResource Text}" FontWeight="Bold" FontSize="13"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="SyncLoginPanel" Margin="0,16,0,0">
                            <TextBlock Text="E-posta" Style="{StaticResource SettingsLabel}"/>
                            <TextBox x:Name="SyncEmail" HorizontalAlignment="Left" Width="360"/>
                            <TextBlock Text="Şifre" Style="{StaticResource SettingsLabel}" Margin="4,12,0,6"/>
                            <PasswordBox x:Name="SyncPassword" Width="360" HorizontalAlignment="Left" KeyDown="SyncPassword_KeyDown"/>
                            <TextBlock x:Name="SyncMsg" Foreground="{StaticResource Danger}" FontSize="12.5" FontWeight="Bold" Margin="2,10,0,0"
                                       TextWrapping="Wrap" Visibility="Collapsed"/>
                            <WrapPanel Margin="0,16,0,0">
                                <Button x:Name="SyncLoginBtn" Content="Giriş yap" Style="{StaticResource Primary}" Margin="0,0,10,0" Click="SyncLogin_Click"/>
                                <Button x:Name="SyncSignupBtn" Content="Kayıt ol" Style="{StaticResource Btn}" Click="SyncSignup_Click"/>
                            </WrapPanel>
                        </StackPanel>

                        <WrapPanel x:Name="SyncAccountPanel" Margin="0,16,0,0" Visibility="Collapsed">
                            <Button Style="{StaticResource Primary}" Margin="0,0,10,0" Click="SyncNow_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M19,12 A7,7 0 1 1 16.9,7 M17.5,3.5 L17.5,7.5 L13.5,7.5" Style="{StaticResource Icon}" Width="15" Height="15"/>
                                    <TextBlock Text="Şimdi senkronla" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Content="Çıkış yap" Style="{StaticResource DangerBtn}" Click="SyncLogout_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Süreleri sıfırla -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <DockPanel>
                            <Grid Style="{StaticResource SettingsBadge}">
                                <Ellipse Fill="{StaticResource DangerSoft}"/>
                                <Path Data="{StaticResource IconTrash}" Style="{StaticResource Icon}" Stroke="{StaticResource Danger}" Width="20" Height="20"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Süreleri sıfırla" Style="{StaticResource H}" Margin="0"/>
                                <TextBlock Text="Seçtiğin dönemdeki tüm çalışma kayıtları silinir. Bu işlem geri alınamaz."
                                           Style="{StaticResource Body}" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="Bugünü sıfırla" Tag="today" Style="{StaticResource DangerBtn}" Margin="0,0,10,8" Click="ResetPeriod_Click"/>
                            <Button Content="Bu haftayı sıfırla" Tag="week" Style="{StaticResource DangerBtn}" Margin="0,0,10,8" Click="ResetPeriod_Click"/>
                            <Button Content="Bu ayı sıfırla" Tag="month" Style="{StaticResource DangerBtn}" Margin="0,0,10,8" Click="ResetPeriod_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Widget modu: çerçeve ve küçük kontroller -->
        <Border x:Name="WidgetFrame" Grid.RowSpan="2" BorderBrush="{StaticResource Line}" BorderThickness="2" CornerRadius="0"
                IsHitTestVisible="False" Visibility="Collapsed"/>
        <StackPanel x:Name="WidgetBar" Grid.RowSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Visibility="Collapsed">
            <Button x:Name="PinBtn" Style="{StaticResource Ghost}" Padding="7" ToolTip="Her zaman üstte: kapalı" Click="WidgetPin_Click">
                <Path Data="{StaticResource IconPin}" Style="{StaticResource Icon}" Width="14" Height="14" StrokeThickness="2.2"/>
            </Button>
            <Button Style="{StaticResource Ghost}" Padding="7" ToolTip="Tam görünüme dön (Esc)" Click="WidgetToggle_Click">
                <Path Data="{StaticResource IconExpand}" Style="{StaticResource Icon}" Width="14" Height="14" StrokeThickness="2.2"/>
            </Button>
            <Button Style="{StaticResource Ghost}" Padding="7" ToolTip="Kapat" Click="WidgetClose_Click">
                <Path Data="{StaticResource IconClose}" Style="{StaticResource Icon}" Width="14" Height="14" StrokeThickness="2.2"/>
            </Button>
        </StackPanel>
        <!-- Efekt katmanı: oturum sonu jeton ödülü vb. (MainWindow.Coins.cs) -->
        <Canvas x:Name="FxLayer" Grid.RowSpan="2" IsHitTestVisible="False" Panel.ZIndex="100"/>
    </Grid>
</Window>
