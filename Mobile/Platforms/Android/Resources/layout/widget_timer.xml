<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/w_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/widget_bg"
	android:paddingStart="12dp"
	android:paddingEnd="12dp"
	android:paddingTop="8dp"
	android:paddingBottom="8dp">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:gravity="center_vertical"
		android:orientation="horizontal">

		<FrameLayout
			android:layout_width="58dp"
			android:layout_height="58dp">

			<ImageView
				android:id="@+id/w_ring"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:scaleType="fitCenter" />

			<Chronometer
				android:id="@+id/w_time"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="center"
				android:textColor="#EEF1FF"
				android:textSize="12sp"
				android:textStyle="bold" />
		</FrameLayout>

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="12dp"
			android:layout_weight="1"
			android:gravity="center_vertical"
			android:orientation="vertical">

			<TextView
				android:id="@+id/w_course"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:ellipsize="end"
				android:maxLines="1"
				android:textColor="#EEF1FF"
				android:textSize="15sp"
				android:textStyle="bold" />

			<TextView
				android:id="@+id/w_status"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:ellipsize="end"
				android:maxLines="1"
				android:textColor="#8791B5"
				android:textSize="11sp" />

			<TextView
				android:id="@+id/w_today"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:ellipsize="end"
				android:maxLines="1"
				android:textColor="#C9D0EE"
				android:textSize="11sp" />
		</LinearLayout>

		<ImageView
			android:id="@+id/w_toggle"
			android:layout_width="38dp"
			android:layout_height="38dp"
			android:layout_gravity="center_vertical" />

		<ImageView
			android:id="@+id/w_stop"
			android:layout_width="38dp"
			android:layout_height="38dp"
			android:layout_gravity="center_vertical"
			android:layout_marginStart="8dp" />
	</LinearLayout>
</FrameLayout>
