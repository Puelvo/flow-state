<?xml version="1.0" encoding="utf-8"?>
<!-- Tek satırlık (alçak) widget: bilgi solda, düğmeler sağda. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/w_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<ImageView
		android:id="@+id/w_scene"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:contentDescription="@string/widget_description"
		android:scaleType="fitXY" />

	<LinearLayout
		android:id="@+id/w_info"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center_vertical|start"
		android:layout_marginStart="10dp"
		android:background="@drawable/widget_glass"
		android:gravity="start"
		android:orientation="vertical"
		android:paddingStart="12dp"
		android:paddingEnd="12dp"
		android:paddingTop="4dp"
		android:paddingBottom="5dp">

		<TextView
			android:id="@+id/w_course"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:maxWidth="150dp"
			android:maxLines="1"
			android:textColor="#3B2C25"
			android:textSize="12sp"
			android:textStyle="bold" />

		<Chronometer
			android:id="@+id/w_time"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:includeFontPadding="false"
			android:textColor="#3B2C25"
			android:textSize="20sp"
			android:textStyle="bold" />

		<TextView
			android:id="@+id/w_status"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:maxLines="1"
			android:textColor="#8A756A"
			android:textSize="10sp"
			android:textStyle="bold" />
	</LinearLayout>

	<LinearLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center_vertical|end"
		android:layout_marginEnd="10dp"
		android:orientation="horizontal">

		<ImageView
			android:id="@+id/w_stop"
			android:layout_width="44dp"
			android:layout_height="40dp"
			android:layout_marginEnd="8dp"
			android:contentDescription="@string/widget_stop"
			android:scaleType="fitCenter" />

		<ImageView
			android:id="@+id/w_toggle"
			android:layout_width="56dp"
			android:layout_height="40dp"
			android:contentDescription="@string/widget_toggle"
			android:scaleType="fitCenter" />
	</LinearLayout>
</FrameLayout>
