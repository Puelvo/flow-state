<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>FlowState</AssemblyName>
    <Product>Flow State</Product>
    <RootNamespace>StudyAssistant</RootNamespace>
  </PropertyGroup>

  <!-- Android (MAUI) projesi Mobile klasöründe; Windows derlemesine karışmasın -->
  <ItemGroup>
    <Compile Remove="Mobile\**" />
    <Page Remove="Mobile\**" />
    <EmbeddedResource Remove="Mobile\**" />
    <None Remove="Mobile\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

</Project>

